# Copy to `.env.local` for local overrides.
# Vite only exposes variables prefixed with VITE_ to the web app.
# Do not put private keys in this file.

VITE_APP_TITLE=Nova

# Soft-launch geo gate. Set to 1 to force the locked EN geo-block screen.
# VITE_GEO_BLOCKED=1

# Arc mainnet demo (/demo). Leave pool and signal blank until a human deploy.
# Chain id is fixed at 5042 in the app. Testnet-only is not a Microgrant submit.
VITE_ARC_RPC_URL=https://rpc.mainnet.arc.io
VITE_ARC_EXPLORER_URL=https://explorer.arc.io
VITE_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
VITE_NOVA_POOL_ADDRESS=
VITE_NOVA_SIGNAL_ADDRESS=
# Optional sample tx hashes (0x + 64 hex) after a human broadcasts them.
VITE_DEMO_BUY_TX=
VITE_DEMO_SIGNAL_TX=
