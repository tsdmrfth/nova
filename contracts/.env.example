# Copy to `contracts/.env` (gitignored). Do not commit keys or filled addresses.
# Arc mainnet is chain id 5042. Testnet-only is not a Microgrant deploy.
# ALLOW_NON_MAINNET=true is a local rehearsal switch only.

ARC_RPC_URL=https://rpc.mainnet.arc.io

# forge script reads this via the CLI (--private-key), not from Solidity.
DEPLOYER_PRIVATE_KEY=

# Public Arc ERC-20 USDC interface (Circle docs). Override only for a local mock.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

STUDIO_ADDRESS=0x0000000000000000000000000000000000000000
NOVA_WALLET=0x0000000000000000000000000000000000000000
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
SIGNAL_AGENT=0x0000000000000000000000000000000000000000

# Hard cap in micro-USDC (6 decimals). 1000000 = 1 USDC.
SIGNAL_CAP_MICRO=1000000

# Set true only to rehearsal against anvil. Leave unset for mainnet.
# ALLOW_NON_MAINNET=
