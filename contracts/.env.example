# Copy to `contracts/.env.local` (gitignored). Do not commit keys or filled addresses.
# Arc mainnet is chain id 5042. Testnet-only is not a Microgrant deploy.
# ALLOW_NON_MAINNET=true allows testnet (5042002) or anvil.

ARC_RPC_URL=https://rpc.mainnet.arc.io

# No private key here: broadcast with a Foundry keystore (`--account nova-deployer`).

# Public Arc ERC-20 USDC interface (Circle docs). Override only for a local mock.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

STUDIO_ADDRESS=0x0000000000000000000000000000000000000000
NOVA_WALLET=0x0000000000000000000000000000000000000000
# Final owner of both contracts (a Safe on mainnet). Must call acceptOwnership() on both.
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
# Hot key that settles and opens days, and can pause.
OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
SIGNAL_AGENT=0x0000000000000000000000000000000000000000

# Hard cap in micro-USDC (6 decimals). 1000000 = 1 USDC.
SIGNAL_CAP_MICRO=1000000

# Unix seconds for day 1's vote close. Optional.
# FIRST_DAY_CLOSES_AT=

# Set true for testnet or anvil. Leave unset for mainnet.
# ALLOW_NON_MAINNET=
